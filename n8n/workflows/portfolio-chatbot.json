{
  "name": "Portfolio Chatbot with SearXNG",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "portfolio-chat",
        "responseMode": "responseNode",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS, GET"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type, Authorization"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "webhook-trigger",
      "name": "Webhook"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "Bạn là trợ lý AI đại diện cho Long Nguyễn trên website portfolio cá nhân (long-nguyen.curator.io.vn).\n\nTHÔNG TIN VỀ LONG NGUYỄN:\n- Nghề nghiệp: DevOps Engineer / Platform Engineer.\n- Email liên hệ: fcvtieulongg12@gmail.com\n- Số điện thoại: +84 399 424 608\n- Địa điểm: TP. Hồ Chí Minh, Việt Nam.\n- Công ty hiện tại: Saigon Technology (DevOps Engineer).\n- Kinh nghiệm trước đây: CODE88 (System / Platform Engineer), STYL Solutions (DevOps Engineer), Snetel Technologies.\n- Kỹ năng cốt lõi (Core Skills):\n  + Cloud: AWS (EKS, ECS, RDS, VPC), GCP, Azure.\n  + Container & Điều phối: Kubernetes, Docker, Helm, ArgoCD GitOps.\n  + IaC & CI/CD: Terraform, GitLab CI, Bitbucket Pipelines, Ansible.\n  + Giám sát & Bảo mật: Prometheus, Grafana, ELK Stack, ISO 27001, Trivy, DevSecOps.\n\nQUY TẮC TRẢ LỜI:\n1. NGẮN GỌN & SÚC TÍCH: Đi thẳng vào trọng tâm câu hỏi. Câu trả lời gọn gàng, súc tích, tối đa 2-5 gạch đầu dòng ngắn, không viết lan man hoặc mở bài/kết bài rườm rà.\n2. LIÊN HỆ: Khi hỏi cách liên hệ, cung cấp ngay Email (fcvtieulongg12@gmail.com) và Phone (+84 399 424 608).\n3. TÌM KIẾM WEB: Với câu hỏi về tin tức, công nghệ mới nhất hoặc dữ liệu thời gian thực, chủ động dùng tool searxng_search.\n4. Đa ngôn ngữ: Phản hồi đúng theo ngôn ngữ người dùng hỏi (Tiếng Việt hoặc Tiếng Anh)."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        300,
        0
      ],
      "id": "ai-agent",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        180,
        220
      ],
      "id": "gemini-model",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "gemini-api-key",
          "name": "Google Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $('Webhook').item.json.body.sessionId || 'default-session' }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        340,
        220
      ],
      "id": "window-memory",
      "name": "Window Buffer Memory"
    },
    {
      "parameters": {
        "name": "searxng_search",
        "description": "Search the internet using SearXNG for real-time information, news, documentation, and facts. Input is the search query.",
        "method": "GET",
        "url": "https://searxng.curator.io.vn/search",
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "q",
              "value": "={{{ $fromAI('query', 'The search query to look up on the web') }}}"
            },
            {
              "name": "format",
              "value": "json"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        500,
        220
      ],
      "id": "searxng-tool",
      "name": "searxng_search"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: $json.output, sessionId: $('Webhook').item.json.body.sessionId }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS, GET"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type, Authorization"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        0
      ],
      "id": "respond-webhook",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "searxng_search": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
